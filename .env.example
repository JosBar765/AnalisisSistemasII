# =====================================================================
# Base de datos (PostgreSQL)
# =====================================================================
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# =====================================================================
# API (Spring Boot) - desarrollo local
# =====================================================================
SERVER_PORT=
JWT_SECRET=
# Orígenes permitidos por CORS. Se permite http://localhost:${FRONTEND_PORT}
# En producción (Railway) definirlo con la URL pública del frontend.
CORS_ALLOWED_ORIGINS=

# =====================================================================
# API en producción (Railway)
# =====================================================================
# URL pública de la API; la local se arma con SERVER_PORT.
API_URL_PRODUCTION=
# Definir SPRING_PROFILES_ACTIVE=prod como variable del servicio: con ese perfil, la falta de
# Supabase se registra como ERROR en los logs (en desarrollo solo INFO).

# =====================================================================
# Frontend (Angular)
# =====================================================================
# Puerto de `npm start` (4200 si se omite).
FRONTEND_PORT=

# =====================================================================
# Supabase Storage (documentos clínicos)
# =====================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
