# Configuración de la base de datos
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Configuración API
SERVER_PORT=
CORS_ALLOWED_ORIGINS=
JWT_SECRET=

# URL pública de la API en producción (Railway); la local se arma con SERVER_PORT
API_URL_PRODUCTION=

# Supabase Storage (documentos clinicos)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# En producción (Railway) definir SPRING_PROFILES_ACTIVE=prod como variable del servicio:
# con ese perfil, la falta de Supabase se registra como ERROR en los logs (en desarrollo solo INFO).
